generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChannelType {
  PUBLIC
  PRIVATE
  THEME
  RADIO       // Só o dono (e quem ele convida) transmite; os outros ouvem
}

enum ChannelMode {
  FREE        // Qualquer um fala quando quer
  MODERATED   // Só fala quem o criador autoriza
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String   // bcrypt hash
  role      Role     @default(USER)
  banned    Boolean  @default(false)
  bannedAt  DateTime?
  photoUrl  String?
  bio       String?
  country   String?
  language  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdChannels  Channel[]           @relation("ChannelCreator")
  createdPlaylists Playlist[]          @relation("PlaylistCreator")
  playlistsJoined  PlaylistListener[]
  messages         Message[]
  friendsInitiated Friendship[]        @relation("FriendA")
  friendsReceived  Friendship[]        @relation("FriendB")
  mutedByMe        Mute[]              @relation("Muter")
  mutedMe          Mute[]              @relation("Muted")
}

model Channel {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  type        ChannelType @default(PUBLIC)
  mode        ChannelMode @default(FREE)
  accessCode  String?     // Código de acesso para canais privados (null = sem código)
  createdAt   DateTime    @default(now())
  expiresAt   DateTime?   // Quando o canal expira (null = nunca; para privados = +5 dias)

  creatorId String?
  creator   User?   @relation("ChannelCreator", fields: [creatorId], references: [id])

  VoiceLog VoiceLog[]
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  channelId Int
  channel   Channel @relation(fields: [channelId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Friendship {
  id        String       @id @default(cuid())
  status    FriendStatus @default(PENDING)
  createdAt DateTime     @default(now())

  aId String
  a   User   @relation("FriendA", fields: [aId], references: [id])
  bId String
  b   User   @relation("FriendB", fields: [bId], references: [id])

  @@unique([aId, bId])
}

model VoiceLog {
  id         Int      @id @default(autoincrement())
  userId     String
  userName   String
  durationMs Int
  createdAt  DateTime @default(now())
  channelId  Int
  Channel    Channel  @relation(fields: [channelId], references: [id])
}

model Mute {
  id        String   @id @default(cuid())
  muterId   String   // Quem fez mute
  muter     User     @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  mutedId   String   // Quem foi mutado
  muted     User     @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([muterId, mutedId])
}

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  reporterName String
  reportedId   String
  reportedName String
  reason       String
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Playlist {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creatorId String
  creator   User   @relation("PlaylistCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  musics Music[]
  listeners PlaylistListener[]

  @@unique([creatorId, name])
}

model Music {
  id        String   @id @default(cuid())
  title     String
  artist    String?
  duration  Int      // em segundos
  fileUrl   String   // caminho ou URL do ficheiro de áudio
  order     Int      // ordem na playlist
  createdAt DateTime @default(now())

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId])
}

model PlaylistListener {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistId String
  playlist  Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([userId, playlistId])
}
